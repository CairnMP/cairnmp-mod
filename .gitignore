# BMad tooling (local install; not part of the mod)
_bmad/

# BMad output: scratch and rendered output stay local, but the spec contract,
# the research it derives from, and the sprint state the build loop follows
# are project records and belong in history.
# Note the glob: git never descends into an excluded directory, so the
# negations below only work against `_bmad-output/*`, not `_bmad-output/`.
_bmad-output/*
!_bmad-output/specs/
!_bmad-output/planning-artifacts/
!_bmad-output/implementation-artifacts/
# The negations re-include those subtrees wholesale, dotfiles included, so the
# per-session .memlog.md scratch logs rode in against the rule above. Last match
# wins, hence this line sits after them.
_bmad-output/**/.memlog.md

# Logs
*.log

# Brainstorming visual companion (maquettes jetables)
.superpowers/

# Dossier temporaire (outils de debug jetables)
.tmp/

# Scripts
scripts/sync-versions.js
# bmad-loop orchestrator state (regenerated by `bmad-loop init`)
.bmad-loop/

# Editor workspace files (personal)
*.code-workspace
