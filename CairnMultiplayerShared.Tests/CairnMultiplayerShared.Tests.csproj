<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <!--
      All three sit AT their net6.0 ceiling, for two different reasons.
      Test.Sdk and the runner are the dangerous pair: raised past their ceiling they
      still restore cleanly via AssetTargetFallback, then fail at runtime with
      "Could not find testhost". xunit is not like that — 2.9.3 simply ends the v2
      line, and v3 floors at net8.0. Ceilings and reasoning:
      _bmad-output/specs/spec-cairnmp-melonloader-stack-currency/stack.md
    -->
    <!-- net6.0 ceiling: 17.14.0 drops net6.0 -->
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="[17.13.0]" />
    <!-- net6.0 ceiling: last of the v2 line; v3 floors at net8.0 -->
    <PackageReference Include="xunit" Version="[2.9.3]" />
    <!-- net6.0 ceiling: 3.1.0 drops net6.0 -->
    <PackageReference Include="xunit.runner.visualstudio" Version="[3.0.2]" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CairnMultiplayerShared\CairnMultiplayerShared.csproj" />
  </ItemGroup>

</Project>
