<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Source generator run at COMPILE time on the developer's machine: it lists the classes
    deriving from MultiplayerFeature so that adding a feature means adding one file.
    Nothing of this project ships in the mod, and no reflection happens in game.

    Must target netstandard2.0 — that is what Roslyn loads analyzers as.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <!--
      RS2008 exige un fichier de suivi des versions de regles, utile pour un analyseur
      distribue publiquement dont les consommateurs doivent suivre les changements. Ici le
      generateur ne sert qu'a ce depot : nos diagnostics naissent et meurent avec lui.
    -->
    <NoWarn>$(NoWarn);RS2008</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" PrivateAssets="all" />
  </ItemGroup>

</Project>
